#!/usr/bin/env bash

#ddev-generated

## Description: Shared interface for application surface DDEV project interactions
## Usage: surface <api|app|admin|shop|auto-connect> [connect|ddev-command] [args...]
## Example: "ddev surface api connect cobrofacil"
## Example: "ddev surface shop describe"

set -euo pipefail

app_root="${DDEV_APPROOT:-$(pwd)}"
command_name="$(basename "$0")"

if [ "${command_name}" = "surface" ]; then
    relation="${1:-}"

    case "${relation}" in
        api|app|admin|shop)
            shift
            ;;
        auto-connect)
            ;;
        *)
            printf '\033[31m%s\033[0m\n' "Usage: ddev surface <api|app|admin|shop|auto-connect> <connect|ddev-command> [args...]" >&2
            exit 1
            ;;
    esac
else
    relation="${CONNECTION_COMMAND_NAME:-${command_name}}"
fi

connection_directory_name=".ddev/connections"

usage() {
    cat >&2 <<USAGE
Usage:
  ddev ${relation} connect <project>
  ddev ${relation} [describe-options]
  ddev ${relation} <ddev-command> [args...]
USAGE
}

fail() {
    printf '\033[31m%s\033[0m\n' "$1" >&2
    exit 1
}

require_jq() {
    command -v jq >/dev/null 2>&1 || fail "The ${relation} command requires jq to parse DDEV metadata."
}

is_frontend_role() {
    case "$1" in
        app|admin|shop) return 0 ;;
        *) return 1 ;;
    esac
}

project_role() {
    local project="$1"
    local type="$2"

    case "${project}:${type}" in
        *-api:laravel) echo "api" ;;
        *-app:generic) echo "app" ;;
        *-admin:generic) echo "admin" ;;
        *-shop:generic) echo "shop" ;;
    esac
}

project_base_name() {
    local project="$1"
    local role="$2"
    echo "${project%-"${role}"}"
}

validate_pairing() {
    local local_role="$1"
    local target_role="$2"

    if [ "${local_role}" = "api" ] && is_frontend_role "${target_role}"; then
        return 0
    fi

    if is_frontend_role "${local_role}" && [ "${target_role}" = "api" ]; then
        return 0
    fi

    fail "Connections from ${local_role} to ${target_role} are not allowed."
}

normalize_project() {
    local project="$1"

    if [[ "${project}" == *-"${relation}" ]]; then
        echo "${project}"
    else
        echo "${project}-${relation}"
    fi
}

connection_file_for() {
    local approot="$1"
    local connection_name="$2"
    echo "${approot}/${connection_directory_name}/${connection_name}"
}

read_connection() {
    local approot="$1"
    local connection_name="$2"
    local connection_file

    connection_file="$(connection_file_for "${approot}" "${connection_name}")"
    [ -f "${connection_file}" ] || return 0
    sed -n '1s/[[:space:]]*$//p' "${connection_file}"
}

connected_project() {
    local project
    project="$(read_connection "${app_root}" "${relation}")"
    [ -n "${project}" ] || fail "A ${relation} has not been connected."
    echo "${project}"
}

describe_project() {
    local project="$1"
    ddev describe "${project}" --json-output 2>/dev/null || fail "DDEV project '${project}' was not found or cannot be described."
}

project_approot_from_list() {
    local project="$1"
    ddev list --json-output | jq -r --arg project "${project}" '.raw[]? | select(.name == $project) | .approot' | sed -n '1p'
}

project_approot() {
    local project="$1"
    local describe_json="$2"
    local approot

    approot="$(project_approot_from_list "${project}")"
    [ -n "${approot}" ] || approot="$(jq -r '.raw.approot // empty' <<< "${describe_json}")"
    [ -n "${approot}" ] || fail "Could not resolve the app root for DDEV project '${project}'."
    echo "${approot}"
}

current_project_json() {
    cd "${app_root}" && ddev describe --json-output
}

project_url() {
    local approot="$1"
    local connection_name="$2"
    local url

    url="$(cd "${approot}" && ddev url | awk 'NF { print; exit }')"
    [ -n "${url}" ] || fail "${connection_name^} ddev url did not return a URL."
    echo "${url}"
}

url_host() {
    local url="$1"
    local host="${url#*://}"
    host="${host%%/*}"
    host="${host%%:*}"
    [ -n "${host}" ] || fail "Could not extract a host from URL '${url}'."
    echo "${host}"
}

url_scheme() {
    local url="$1"
    echo "${url%%://*}"
}

reverb_port() {
    local api_approot="$1"
    local port

    port="$(awk '
        /^[[:space:]]*-[[:space:]]*name:[[:space:]]*reverb[[:space:]]*$/ { in_reverb = 1; next }
        in_reverb && /^[[:space:]]*-[[:space:]]*name:/ { in_reverb = 0 }
        in_reverb && /^[[:space:]]*https_port:/ { print $2; exit }
    ' "${api_approot}"/.ddev/config*.yaml 2>/dev/null || true)"
    echo "${port:-8880}"
}

env_value() {
    local file="$1"
    local key="$2"
    [ -f "${file}" ] || return 0
    awk -F= -v key="${key}" '$1 == key { value = substr($0, length(key) + 2); gsub(/\r$/, "", value); gsub(/^\047|\047$/, "", value); gsub(/^"|"$/, "", value); print value; exit }' "${file}"
}

set_env_value() {
    local file="$1"
    local key="$2"
    local value="$3"

    mkdir -p "$(dirname "${file}")"
    [ -f "${file}" ] || touch "${file}"

    if [ ! -s "${file}" ]; then
        printf '%s=%s\n' "${key}" "${value}" > "${file}"
        return 0
    fi

    KEY="${key}" VALUE="${value}" perl -0pi -e '
        my $key = $ENV{"KEY"};
        my $value = $ENV{"VALUE"};
        my $line = "$key=$value";
        if (!s/^(\Q$key\E=).*$/$line/m) {
            s/\z/\n/ unless /\n\z/;
            $_ .= "$line\n";
        }
    ' "${file}"
}

update_frontend_environment() {
    local frontend_approot="$1"
    local frontend_role="$2"
    local api_approot="$3"
    local environment_file="${frontend_approot}/.env.local"
    local api_url

    api_url="$(project_url "${api_approot}" "api")"
    set_env_value "${environment_file}" "VITE_API_URL" "${api_url}"

    if [ "${frontend_role}" = "app" ]; then
        set_env_value "${environment_file}" "VITE_REVERB_HOST" "$(url_host "${api_url}")"
        set_env_value "${environment_file}" "VITE_REVERB_PORT" "$(reverb_port "${api_approot}")"
        set_env_value "${environment_file}" "VITE_REVERB_SCHEME" "$(url_scheme "${api_url}")"
        set_env_value "${environment_file}" "VITE_REVERB_APP_KEY" "$(env_value "${api_approot}/.ddev/.env" "REVERB_APP_KEY")"
    fi

    echo "Updated ${environment_file}."
}

update_api_environment() {
    local api_approot="$1"
    local app_approot="$2"
    local environment_file="${api_approot}/.env"
    set_env_value "${environment_file}" "APP_URL" "$(project_url "${app_approot}" "app")"
    echo "Updated ${environment_file}."
}

run_connection_hooks() {
    local local_approot="$1"
    local local_role="$2"
    local target_approot="$3"
    local target_role="$4"
    local api_approot
    local frontend_approot
    local frontend_role

    if [ "${local_role}" = "api" ]; then
        api_approot="${local_approot}"
        frontend_approot="${target_approot}"
        frontend_role="${target_role}"
    else
        api_approot="${target_approot}"
        frontend_approot="${local_approot}"
        frontend_role="${local_role}"
    fi

    update_frontend_environment "${frontend_approot}" "${frontend_role}" "${api_approot}"
    [ "${frontend_role}" != "app" ] || update_api_environment "${api_approot}" "${frontend_approot}"
}

write_connection() {
    local approot="$1"
    local connection_name="$2"
    local project="$3"
    local directory="${approot}/${connection_directory_name}"
    mkdir -p "${directory}"
    printf '%s\n' "${project}" > "${directory}/${connection_name}"
}

remove_connection_if_points_to() {
    local approot="$1"
    local connection_name="$2"
    local expected_project="$3"
    local owner_project="$4"
    local connection_file

    connection_file="$(connection_file_for "${approot}" "${connection_name}")"
    [ "$(read_connection "${approot}" "${connection_name}")" = "${expected_project}" ] || return 0
    rm "${connection_file}"
    echo "Disconnected ${connection_name} project '${expected_project}' in ${owner_project}."
}

remove_reciprocal_connection() {
    local old_project="$1"
    local connection_name="$2"
    local expected_project="$3"
    local old_approot

    old_approot="$(project_approot_from_list "${old_project}")"
    if [ -z "${old_approot}" ]; then
        echo "Skipped stale ${connection_name} cleanup because DDEV project '${old_project}' is unavailable."
        return 0
    fi
    remove_connection_if_points_to "${old_approot}" "${connection_name}" "${expected_project}" "${old_project}"
}

disconnect_existing_connection() {
    local approot="$1"
    local connection_name="$2"
    local project="$3"
    local reciprocal_connection_name="$4"
    local expected_project="$5"
    local existing_project

    existing_project="$(read_connection "${approot}" "${connection_name}")"
    if [ -n "${existing_project}" ] && [ "${existing_project}" != "${project}" ]; then
        remove_reciprocal_connection "${existing_project}" "${reciprocal_connection_name}" "${expected_project}"
    fi
}

connect_project() {
    [ "$#" -ge 1 ] && [ "$#" -le 2 ] || { usage; exit 1; }
    require_jq

    local mode="${2:-reciprocal}"
    local target_project target_json target_type target_role target_approot
    local local_json local_project local_type local_role

    case "${mode}" in reciprocal|one-way) ;; *) fail "Unsupported connection mode '${mode}'." ;; esac

    target_project="$(normalize_project "$1")"
    target_json="$(describe_project "${target_project}")"
    target_type="$(jq -r '.raw.type // empty' <<< "${target_json}")"
    target_role="$(project_role "${target_project}" "${target_type}")"
    [ "${target_role}" = "${relation}" ] || fail "DDEV project '${target_project}' is not a ${relation} project."

    local_json="$(current_project_json)"
    local_project="$(jq -r '.raw.name // empty' <<< "${local_json}")"
    local_type="$(jq -r '.raw.type // empty' <<< "${local_json}")"
    local_role="$(project_role "${local_project}" "${local_type}")"
    [ -n "${local_role}" ] || fail "The current DDEV project does not have a supported surface role."
    validate_pairing "${local_role}" "${target_role}"

    target_approot="$(project_approot "${target_project}" "${target_json}")"
    disconnect_existing_connection "${app_root}" "${relation}" "${target_project}" "${local_role}" "${local_project}"
    write_connection "${app_root}" "${relation}" "${target_project}"
    echo "Connected ${relation} project '${target_project}'."

    if [ "${mode}" = "one-way" ]; then
        remove_connection_if_points_to "${target_approot}" "${local_role}" "${local_project}" "${target_project}"
        return 0
    fi

    disconnect_existing_connection "${target_approot}" "${local_role}" "${local_project}" "${target_role}" "${target_project}"
    write_connection "${target_approot}" "${local_role}" "${local_project}"
    run_connection_hooks "${app_root}" "${local_role}" "${target_approot}" "${target_role}"
    echo "Connected ${local_role} project '${local_project}' in ${target_project}."
}

write_placeholder_connection() {
    local target_role="$1"
    local target_project="$2"
    write_connection "${app_root}" "${target_role}" "${target_project}"
    echo "No ${target_role} project found. Falling back to '${target_project}'."
}

auto_connect_relation() {
    local local_project="$1"
    local local_role="$2"
    local project_base="$3"
    local target_role="$4"
    local saved_project target_project target_type target_role_found

    relation="${target_role}"
    saved_project="$(read_connection "${app_root}" "${target_role}")"

    if [ -n "${saved_project}" ]; then
        target_type="$(ddev describe "${saved_project}" --json-output 2>/dev/null | jq -r '.raw.type // empty' || true)"
        target_role_found="$(project_role "${saved_project}" "${target_type}")"
        if [ "${target_role_found}" = "${target_role}" ]; then
            connect_project "${saved_project}"
            return 0
        fi
    fi

    target_project="${project_base}-${target_role}"
    target_type="$(ddev list --json-output | jq -r --arg project "${target_project}" '.raw[]? | select(.name == $project) | .type' | sed -n '1p')"
    target_role_found="$(project_role "${target_project}" "${target_type}")"

    if [ "${target_role_found}" = "${target_role}" ]; then
        connect_project "${target_project}"
    else
        write_placeholder_connection "${target_role}" "${target_project}"
    fi
}

auto_connect_project() {
    [ "$#" -eq 0 ] || { usage; exit 1; }
    require_jq

    local local_json local_project local_type local_role project_base target_role
    local_json="$(current_project_json)"
    local_project="$(jq -r '.raw.name // empty' <<< "${local_json}")"
    local_type="$(jq -r '.raw.type // empty' <<< "${local_json}")"
    local_role="$(project_role "${local_project}" "${local_type}")"
    [ -n "${local_role}" ] || fail "The current DDEV project does not have a supported surface role."
    project_base="$(project_base_name "${local_project}" "${local_role}")"

    if [ "${local_role}" = "api" ]; then
        for target_role in app admin shop; do
            auto_connect_relation "${local_project}" "${local_role}" "${project_base}" "${target_role}"
        done
    else
        auto_connect_relation "${local_project}" "${local_role}" "${project_base}" "api"
    fi
}

forward_to_connected_project() {
    require_jq
    local project target_json target_type target_role target_approot
    local local_json local_project local_type local_role reciprocal_project

    project="$(connected_project)"
    target_json="$(describe_project "${project}")"
    target_type="$(jq -r '.raw.type // empty' <<< "${target_json}")"
    target_role="$(project_role "${project}" "${target_type}")"
    [ "${target_role}" = "${relation}" ] || fail "Connected DDEV project '${project}' is not a ${relation} project."

    local_json="$(current_project_json)"
    local_project="$(jq -r '.raw.name // empty' <<< "${local_json}")"
    local_type="$(jq -r '.raw.type // empty' <<< "${local_json}")"
    local_role="$(project_role "${local_project}" "${local_type}")"
    [ -n "${local_role}" ] || fail "The current DDEV project does not have a supported surface role."
    validate_pairing "${local_role}" "${target_role}"

    target_approot="$(project_approot "${project}" "${target_json}")"
    reciprocal_project="$(read_connection "${target_approot}" "${local_role}")"
    [ "${reciprocal_project}" = "${local_project}" ] || fail "The ${relation} connection to '${project}' is not reciprocal. Run 'ddev ${relation} connect ${project}'."

    cd "${target_approot}"
    ddev "$@"
}

case "${1:-}" in
    connect) shift; connect_project "$@" ;;
    auto-connect) shift; auto_connect_project "$@" ;;
    help) usage ;;
    ""|-*) forward_to_connected_project describe "$@" ;;
    *) forward_to_connected_project "$@" ;;
esac
